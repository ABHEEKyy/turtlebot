    <model name="north_wall"><static>true</static><link name="link"><collision name="collision"><geometry><box><size>10.4 0.2 0.4</size></box></geometry><pose>0 5.1 0.2 0 0 0</pose></collision><visual name="visual"><geometry><box><size>10.4 0.2 0.4</size></box></geometry><pose>0 5.1 0.2 0 0 0</pose></visual></link></model>
    <model name="south_wall"><static>true</static><link name="link"><collision name="collision"><geometry><box><size>10.4 0.2 0.4</size></box></geometry><pose>0 -5.1 0.2 0 0 0</pose></collision><visual name="visual"><geometry><box><size>10.4 0.2 0.4</size></box></geometry><pose>0 -5.1 0.2 0 0 0</pose></visual></link></model>
    <model name="east_wall"><static>true</static><link name="link"><collision name="collision"><geometry><box><size>0.2 10.4 0.4</size></box></geometry><pose>5.1 0 0.2 0 0 0</pose></collision><visual name="visual"><geometry><box><size>0.2 10.4 0.4</size></box></geometry><pose>5.1 0 0.2 0 0 0</pose></visual></link></model>
    <model name="west_wall"><static>true</static><link name="link"><collision name="collision"><geometry><box><size>0.2 10.4 0.4</size></box></geometry><pose>-5.1 0 0.2 0 0 0</pose></collision><visual name="visual"><geometry><box><size>0.2 10.4 0.4</size></box></geometry><pose>-5.1 0 0.2 0 0 0</pose></visual></link></model>
  </world>
